# Optional: leave blank and enter the printer IP in the dashboard on first run.
PRINTER_IP=
PRINTER_NAME=Home_Epson_XP2200
# auto prefers IPP, then falls back to TCP/9100 or LPD.
PRINT_PROTOCOL=auto
WEB_PORT=8080
# Required for the proprietary Epson network-scanner plug-in.
# Licence: https://download.ebz.epson.net/dsc/du/02/eula/global/LINUX_EN.html
EPSON_EULA_ACCEPTED=false
# Optional LAN IP/hostname shown to client devices when using a reverse proxy.
CLIENT_HOST=
# WEB_USERNAME=
# WEB_PASSWORD=
# SECRET_KEY=
