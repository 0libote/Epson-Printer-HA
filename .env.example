# Printer address, names and sharing are owned 100% by the WebUI
# (Settings page, stored in /data/settings.json) — no env vars needed.
# Transport override for the CUPS queue only: auto prefers IPP,
# then falls back to TCP/9100 or LPD.
PRINT_PROTOCOL=auto
WEB_PORT=8080
# Required for the proprietary Epson network-scanner plug-in.
# Licence: https://download.ebz.epson.net/dsc/du/02/eula/global/LINUX_EN.html
EPSON_EULA_ACCEPTED=false
# Optional LAN IP/hostname shown to client devices when using a reverse proxy.
CLIENT_HOST=
# WEB_USERNAME=
# WEB_PASSWORD=
# Set true only when every dashboard request arrives over HTTPS.
SESSION_COOKIE_SECURE=false
# Metadata older than this is removed; 0 keeps it indefinitely.
HISTORY_RETENTION_DAYS=90
HISTORY_POLL_SECONDS=5
HISTORY_COMPLETED_POLL_SECONDS=60
# Keep only the newest generated scans on disk.
MAX_SCAN_FILES=100
# Reject print uploads larger than this (MB).
MAX_UPLOAD_MB=128
# SNMP community for ink levels over Printer-MIB (default "public").
# SNMP_COMMUNITY=public
# Direct headless scanner requires validated /data/epson-profiles/manifest.json.
# Keep legacy until physical scans pass: docs/EPSON_SCAN2_PROFILES.md
EPSON_SCANNER_MODE=legacy
