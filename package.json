{
  "name": "epson-printer-ha",
  "version": "1.4.0",
  "description": "Epson Printer Hub - Bun 1.4 migration",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/frontend/app.ts --outdir public --target browser --minify --sourcemap=linked",
    "build:css": "bun build src/frontend/style.css --outdir public",
    "test": "bun test --timeout 10000",
    "test:watch": "bun test --watch --timeout 10000",
    "lint": "bun x tsc --noEmit",
    "format": "bun x prettier --write ."
  },
  "dependencies": {
    "hono": "^4.9.5",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": []
}
